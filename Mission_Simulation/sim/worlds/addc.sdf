      <render_engine>ogre2</render_engine>
    </plugin>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
      </attenuation>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground">
        <visual name="field">
          <pose>20 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>120 100 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.22 0.34 0.18 1</ambient>
            <diffuse>0.22 0.34 0.18 1</diffuse>
          </material>
        </visual>
        <collision name="field_collision">
          <pose>20 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>120 100 0.1</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
    <model name="home_zone">
      <static>true</static>
      <link name="marker">
        <visual name="home">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry>
            <box>
              <size>2 2 0.005</size>
            </box>
          </geometry>
          <material>
            <ambient>0.15 0.3 0.7 1</ambient>
            <diffuse>0.15 0.3 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <include>
